# Your Mac's LAN IP + API port (default 3000). Physical devices cannot use localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.115:3000/api

# Optional fallback when EXPO_PUBLIC_API_URL is unset
EXPO_PUBLIC_DOMAIN=localhost

# Only if API server sets ADMIN_API_KEY — must match exactly
# EXPO_PUBLIC_ADMIN_API_KEY=your-admin-key
