{
  "expo": {
    "name": "SpectraID",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B1F"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SpectraID needs camera access to capture face images for worker registration.",
        "NSPhotoLibraryUsageDescription": "SpectraID needs photo library access to save captured face images.",
        "NSPhotoLibraryAddUsageDescription": "SpectraID needs to save captured face images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#050B1F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.amar_bharati_07.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "SpectraID needs camera access to perform liveness detection during attendance verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpectraID needs access to save captured face images.",
          "cameraPermission": "SpectraID needs camera access to capture face images for worker registration."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "de05d6e3-26a7-4e5f-a602-479a8157f527"
      }
    }
  }
}
