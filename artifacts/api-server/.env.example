# PostgreSQL connection string (required for API persistence)
# Neon example (use pooler host from Neon dashboard):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# HTTP port (default: 3000)
PORT=3000

# Listen on all interfaces so phones on the same Wi‑Fi can connect (default: 0.0.0.0)
# HOST=0.0.0.0

# Optional: require this bearer token on /api/admin/* routes in production
# ADMIN_API_KEY=change-me-in-production

# Optional: allow POST /api/admin/seed-demo to insert sample plazas/operators (off by default)
# ALLOW_DEMO_SEED=true

# Optional S3 sync settings
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
